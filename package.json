{
   "name": "wiretap-titan-vttrpg",
   "version": "0.0.1",
   "description": "Titan VTTRPG support for the Wiretap AI agent bridge.",
   "license": "MIT",
   "private": true,
   "type": "module",
   "author": "Solidor",
   "devDependencies": {
      "@sveltejs/vite-plugin-svelte": "^7.1.2",
      "autoprefixer": "^10.4.19",
      "eslint": "^9.3.0",
      "eslint-plugin-jsdoc": "^48.2.5",
      "eslint-plugin-svelte": "^2.39.0",
      "happy-dom": "^20.9.0",
      "sass-embedded": "^1.100.0",
      "stylelint": "^16.12.0",
      "stylelint-config-html": "^1.1.0",
      "stylelint-config-standard-scss": "^16.0.0",
      "svelte": "^5.0.0",
      "svelte-preprocess": "^6.0.2",
      "terser": "^5.48.0",
      "vite": "^8.0.14",
      "vitest": "^4.1.7"
   },
   "browserslist": [
      "defaults"
   ],
   "scripts": {
      "build": "vite build",
      "check:build": "node scripts/check-module-build.mjs",
      "check:release": "node scripts/check-module-build.mjs --release",
      "dev": "vite",
      "test": "vitest run",
      "test:watch": "vitest",
      "eslint": "eslint .",
      "eslint-fix": "eslint . --fix",
      "stylelint": "stylelint \"src/**/*.{css,scss,svelte}\" --allow-empty-input",
      "stylelint-fix": "stylelint \"src/**/*.{css,scss,svelte}\" --allow-empty-input --fix"
   }
}
